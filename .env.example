# Application
NODE_ENV=development
APP_BASE_URL=http://localhost:8080
PORT=3001
CORS_ORIGIN=http://localhost:8080
DEFAULT_TIMEZONE=Asia/Singapore

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://frame:frame_dev_password@localhost:5432/frame_db
POSTGRES_USER=frame
POSTGRES_PASSWORD=frame_dev_password
POSTGRES_DB=frame_db

# Security & Encryption (MUST change in production; 32+ random bytes hex/base64)
SESSION_SECRET=change-me-session-secret-at-least-32-chars-long
# Format: v1:<64-hex-chars> (supports key rotation by adding v2:<64-hex-chars> and setting TOTP_ACTIVE_KEY_VERSION=v2)
TOTP_ENCRYPTION_KEYS=v1:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TOTP_ACTIVE_KEY_VERSION=v1

# WebAuthn / Passkeys
WEBAUTHN_RP_NAME=FRAME Assessment Platform
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080

# First-Run Admin Bootstrap
# If ADMIN_EMAIL and ADMIN_PASSWORD are set, the seed/bootstrap script creates the initial Admin.
# If ADMIN_PASSWORD is omitted, a one-time setup token is printed to the API logs on first boot.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@frame.local
ADMIN_PASSWORD=

# Demo Data (disabled by default; set to true only for evaluation/testing)
SEED_DEMO=false

# Email / SMTP (MailHog in docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@frame.local

# File Storage
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=10485760
